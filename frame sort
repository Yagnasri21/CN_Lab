#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <time.h>

#define FRAM_TXT_SIZ 3
#define MAX_NOF_FRAM 127

char str[FRAM_TXT_SIZ * MAX_NOF_FRAM];

struct frame {
    char text[FRAM_TXT_SIZ + 1]; // +1 for null terminator
    int seq_no;
} fr[MAX_NOF_FRAM], shuf_ary[MAX_NOF_FRAM];

// Function to split the message into frames and assign sequence numbers
int assign_seq_no() {
    int k = 0, i = 0, j;
    while (i < strlen(str)) {
        fr[k].seq_no = k;
        for (j = 0; j < FRAM_TXT_SIZ && str[i] != '\0'; j++) {
            fr[k].text[j] = str[i++];
        }
        fr[k].text[j] = '\0'; // Null-terminate the frame text
        k++;
    }

    printf("\nAfter assigning sequence numbers:\n");
    for (i = 0; i < k; i++) {
        printf("%d:%s ", fr[i].seq_no, fr[i].text);
    }

    return k; // Return number of frames
}

// Function to generate a random permutation of frame indices
void generate(int *random_ary, const int limit) {
    int r, i = 0, j;
    srand((unsigned int)time(NULL)); // Seed random number generator

    while (i < limit) {
        r = rand() % limit;
        for (j = 0; j < i; j++) {
            if (random_ary[j] == r)
                break;
        }
        if (i == j) {
            random_ary[i++] = r;
        }
    }
}

// Function to shuffle the frames using the random indices
void shuffle(const int no_frames) {
    int i, random_ary[MAX_NOF_FRAM];
    generate(random_ary, no_frames);

    for (i = 0; i < no_frames; i++) {
        shuf_ary[i] = fr[random_ary[i]];
    }

    printf("\n\nAFTER SHUFFLING:\n");
    for (i = 0; i < no_frames; i++) {
        printf("%d:%s ", shuf_ary[i].seq_no, shuf_ary[i].text);
    }
}

// Function to sort the shuffled frames back into original order
void sort(const int no_frames) {
    int i, j;
    struct frame temp;
    for (i = 0; i < no_frames - 1; i++) {
        for (j = 0; j < no_frames - i - 1; j++) {
            if (shuf_ary[j].seq_no > shuf_ary[j + 1].seq_no) {
                temp = shuf_ary[j];
                shuf_ary[j] = shuf_ary[j + 1];
                shuf_ary[j + 1] = temp;
            }
        }
    }
}

// Main function
int main() {
    int no_frames, i;

    printf("Enter the message: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0'; // Remove newline character

    no_frames = assign_seq_no();
    shuffle(no_frames);
    sort(no_frames);

    printf("\n\nAFTER SORTING:\n");
    for (i = 0; i < no_frames; i++) {
        printf("%s", shuf_ary[i].text);
    }
    printf("\n\n");

    return 0;
}
